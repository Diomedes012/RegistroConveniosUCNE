@page "/institucion/crear"
@page "/institucion/editar/{InstitucionId:int}"
@using RegistroConvenioUCNE.Models
@using RegistroConvenioUCNE.Services
@inject InstitucionesService InstitucionesService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>@(InstitucionId == 0 ? "Nueva Institución" : "Editar Institución")</PageTitle>

<div class="card mb-4" style="background-color: #e9ecef; border: none;">
    <div class="card-body py-4">
        <h2 class="m-0 fw-bold" style="color: #19355C;">
            @(InstitucionId == 0 ? "Crear Institución" : "Editar Institución")
        </h2>
    </div>
</div>

<div class="card shadow-sm border-0 mb-5">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 fw-bold" style="color: #19355C;">Datos de la Institución</h5>
    </div>

    <div class="card-body p-4">
        <EditForm Model="institucion" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="row g-4">
                @if (InstitucionId > 0)
                {
                    <div class="col-md-2">
                        <label class="form-label text-muted small">ID</label>
                        <InputNumber class="form-control bg-light" @bind-Value="institucion.IdInstitucion" disabled />
                    </div>
                }

                <div class="col-md-@(InstitucionId > 0 ? "10" : "12")">
                    <label class="form-label text-muted small">Nombre de la Institución <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="institucion.Nombre" placeholder="Ej: Ministerio de Educación Superior" />
                    <ValidationMessage For="@(() => institucion.Nombre)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small">Tipo de Institución</label>
                    <InputSelect class="form-select" @bind-Value="institucion.TipoInstitucion">
                        <option value="">Seleccione...</option>
                        <option value="Gubernamental">Gubernamental</option>
                        <option value="Educativa">Educativa</option>
                        <option value="ONG">ONG</option>
                        <option value="Empresa Privada">Empresa Privada</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => institucion.TipoInstitucion)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small">Teléfono</label>
                    <InputText class="form-control" @bind-Value="institucion.Telefono" placeholder="000-000-0000" />
                    <ValidationMessage For="@(() => institucion.Telefono)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small">Correo Electrónico</label>
                    <InputText class="form-control" @bind-Value="institucion.Email" placeholder="contacto@ejemplo.com" />
                    <ValidationMessage For="@(() => institucion.Email)" />
                </div>

                <div class="col-md-12">
                    <label class="form-label text-muted small">Dirección</label>
                    <InputTextArea class="form-control" @bind-Value="institucion.Direccion" rows="2" placeholder="Dirección física de la entidad" />
                    <ValidationMessage For="@(() => institucion.Direccion)" />
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-12 d-flex justify-content-between">
                    <a href="/instituciones" class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-success px-4" style="background-color: #198754;">
                        <i class="bi bi-check-lg"></i> Guardar
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger mt-3">
                    <i class="bi bi-exclamation-triangle"></i> @mensajeError
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int InstitucionId { get; set; }
    public Institucion institucion { get; set; } = new Institucion();
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        if (InstitucionId > 0)
        {
            var encontrado = await InstitucionesService.Buscar(InstitucionId);
            if (encontrado != null) institucion = encontrado;
            else mensajeError = "Institución no encontrada.";
        }
    }

    private async Task Guardar()
    {
        try
        {
            if (await InstitucionesService.Guardar(institucion))
                NavigationManager.NavigateTo("/instituciones");
            else
                mensajeError = "No se pudo guardar.";
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }
}
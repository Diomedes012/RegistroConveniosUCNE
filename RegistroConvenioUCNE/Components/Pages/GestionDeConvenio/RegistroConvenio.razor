@page "/crear-convenio"
@using RegistroConvenioUCNE.Models
@using RegistroConvenioUCNE.Services
@inject ConveniosService conveniosService
@inject InstitucionesService institucionesService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<div class="card mb-4" style="background-color: #e9ecef; border: none;">
    <div class="card-body py-4">
        <h2 class="m-0 fw-bold" style="color: #19355C;">Crear Nuevo Convenio</h2>
    </div>
</div>

<div class="card shadow-sm border-0 mb-5">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 fw-bold" style="color: #19355C;">Datos del Convenio</h5>
    </div>

    <EditForm Model="@ConvenioEditar" OnValidSubmit="@GuardarConvenio">
        <DataAnnotationsValidator />

        <div class="card-body p-4">
            <ValidationSummary class="mb-3 text-danger" />

            <div class="row g-4">

                <div class="col-md-12">
                    <label class="form-label text-muted small fw-bold">Institución Vinculada <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <InputSelect @bind-Value="InstitucionSeleccionadaId" class="form-select">
                            <option value="0">-- Seleccione una Institución --</option>
                            @foreach (var inst in ListaInstituciones)
                            {
                                <option value="@inst.IdInstitucion">@inst.Nombre (@inst.TipoInstitucion)</option>
                            }
                        </InputSelect>
                        <a href="/institucion/crear" class="btn btn-outline-secondary" title="Crear nueva institución">
                            <i class="bi bi-plus-lg"></i>
                        </a>
                    </div>
                    @if (InstitucionSeleccionadaId == 0 && formularioEnviado)
                    {
                        <div class="text-danger small mt-1">Debe seleccionar una institución.</div>
                    }
                </div>

                <div class="col-md-12">
                    <label for="titulo" class="form-label text-muted small">Título del Convenio <span class="text-danger">*</span></label>
                    <InputText id="titulo" @bind-Value="ConvenioEditar.Titulo" class="form-control" placeholder="Ej. Acuerdo de cooperación académica" />
                    <ValidationMessage For="@(() => ConvenioEditar.Titulo)" />
                </div>

                <div class="col-md-6">
                    <label for="tipoConvenio" class="form-label text-muted small">Tipo de Convenio</label>
                    <InputText id="tipoConvenio" @bind-Value="ConvenioEditar.TipoConvenio" class="form-control" placeholder="Académico, de movilidad, etc." />
                    <ValidationMessage For="@(() => ConvenioEditar.TipoConvenio)" />
                </div>

                <div class="col-md-6">
                    <label for="categoria" class="form-label text-muted small">Categoría</label>
                    <InputText id="categoria" @bind-Value="ConvenioEditar.Categoria" class="form-control" placeholder="Convenio, Contrato, MOU..." />
                    <ValidationMessage For="@(() => ConvenioEditar.Categoria)" />
                </div>

                <div class="col-md-6">
                    <label for="fechaFirma" class="form-label text-muted small">Fecha de Firma</label>
                    <InputDate id="fechaFirma" @bind-Value="ConvenioEditar.FechaFirma" @bind-Value:after="CalcularDuracion" class="form-control" />
                    <ValidationMessage For="@(() => ConvenioEditar.FechaFirma)" />
                </div>

                <div class="col-md-6">
                    <label for="fechaVencimiento" class="form-label text-muted small">Fecha de Vencimiento</label>
                    <InputDate id="fechaVencimiento" @bind-Value="ConvenioEditar.FechaVencimiento" @bind-Value:after="CalcularDuracion" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label for="duracionMeses" class="form-label text-muted small">Duración (meses)</label>
                    <InputNumber id="duracionMeses" @bind-Value="ConvenioEditar.DuracionMeses" class="form-control bg-light" readonly />
                </div>

                <div class="col-md-6">
                    <label for="estado" class="form-label text-muted small">Estado</label>
                    <InputSelect id="estado" @bind-Value="ConvenioEditar.Estado" class="form-select">
                        <option value="Activo">Activo</option>
                        <option value="Vencido">Vencido</option>
                        <option value="En Renovación">En Renovación</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => ConvenioEditar.Estado)" />
                </div>

                <div class="col-md-12">
                    <label for="archivo" class="form-label text-muted small">Archivo del Convenio (PDF, opcional)</label>
                    <InputFile id="archivo" OnChange="OnFileSelected" class="form-control" />
                </div>

                <div class="col-12">
                    <label for="descripcionObjetivos" class="form-label text-muted small">Descripción y Objetivos</label>
                    <InputTextArea id="descripcionObjetivos" @bind-Value="ConvenioEditar.DescripcionObjetivos" class="form-control" style="height: 120px;" />
                    <ValidationMessage For="@(() => ConvenioEditar.DescripcionObjetivos)" />
                </div>

            </div>
        </div>

        <div class="card-footer bg-white border-top-0 py-3 mb-3 d-flex justify-content-between px-4">
            <button type="button" class="btn btn-secondary px-4" @onclick="Volver">
                <i class="bi bi-arrow-left"></i> Volver
            </button>
            <button type="submit" class="btn btn-success px-4" style="background-color: #198754;">
                <i class="bi bi-floppy"></i> Guardar Convenio
            </button>
        </div>
    </EditForm>
</div>

@code {
    private IBrowserFile? archivo;
    private List<Institucion> ListaInstituciones = new();
    private int InstitucionSeleccionadaId;
    private bool formularioEnviado = false; 

    private Convenio ConvenioEditar = new()
    {
        FechaFirma = DateTime.Now,
        Estado = "Activo"
    };

    protected override async Task OnInitializedAsync()
    {
        ListaInstituciones = await institucionesService.Listar(i => true);
    }

    private async Task GuardarConvenio()
    {
        formularioEnviado = true;
        if (InstitucionSeleccionadaId <= 0) return;

        try
        {
            // --- NUEVA LÓGICA PARA EL ARCHIVO ---
            if (archivo != null)
            {
                // 1. Guardamos el nombre
                ConvenioEditar.NombreArchivo = archivo.Name;

                // 2. Convertimos el archivo a bytes para la Base de Datos
                using var memoryStream = new MemoryStream();

                // Límite de tamaño: 10MB 
                await archivo.OpenReadStream(10 * 1024 * 1024).CopyToAsync(memoryStream);

                ConvenioEditar.ContenidoArchivo = memoryStream.ToArray();
            }
            // -------------------------------------

            ConvenioEditar.UltimaModificacion = DateTime.Now;
            ConvenioEditar.ConvenioInstituciones.Add(new ConvenioInstitucion
            {
                IdInstitucion = InstitucionSeleccionadaId
            });

            var resultado = await conveniosService.Guardar(ConvenioEditar);

            if (resultado)
            {
                NavManager.NavigateTo("/listar-convenio");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void CalcularDuracion()
    {
        if (ConvenioEditar.FechaVencimiento != default(DateTime) &&
            ConvenioEditar.FechaVencimiento > ConvenioEditar.FechaFirma)
        {
            var fechaInicio = ConvenioEditar.FechaFirma;
            var fechaFin = ConvenioEditar.FechaVencimiento;
            int meses = ((fechaFin.Value.Year - fechaInicio.Year) * 12) + fechaFin.Value.Month - fechaInicio.Month;
            ConvenioEditar.DuracionMeses = meses > 0 ? meses : 0;
        }
        else
        {
            ConvenioEditar.DuracionMeses = 0;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        archivo = e.File;
    }

    private void Volver()
    {
        NavManager.NavigateTo("/pantalla-principal");
    }
}
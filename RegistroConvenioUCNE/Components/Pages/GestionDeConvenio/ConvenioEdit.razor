@page "/Convenio/Edit/{ConvenioId:int}"
@using RegistroConvenioUCNE.Models
@using RegistroConvenioUCNE.Services
@inject ConveniosService conveniosService
@inject NavigationManager navigationManager
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<div class="page-header">
    <h3>Editar Convenio (ID: @ConvenioId)</h3>
</div>

<div class="card shadow-lg mb-4">
    <div class="card-header">
        <h5>Datos del Convenio</h5>
    </div>

    <EditForm Model="@ConvenioEditar" OnValidSubmit="@GuardarCambios">
        <DataAnnotationsValidator />
        <div class="card-body">
            <ValidationSummary class="mb-3" />
            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Título del Convenio:</label>
                    <InputText @bind-Value="ConvenioEditar.Titulo" class="form-control" readonly="@esEdicion" />
                    <ValidationMessage For="@(() => ConvenioEditar.Titulo)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tipo de Convenio:</label>
                    <InputText @bind-Value="ConvenioEditar.TipoConvenio" class="form-control" readonly="@esEdicion" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Categoría:</label>
                    <InputText @bind-Value="ConvenioEditar.Categoria" class="form-control" readonly="@esEdicion" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de Firma:</label>
                    <InputDate @bind-Value="ConvenioEditar.FechaFirma" class="form-control" readonly="@esEdicion" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de Vencimiento:</label>
                    <InputDate @bind-Value="ConvenioEditar.FechaVencimiento" class="form-control" readonly="@esEdicion" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Duración (meses):</label>
                    <InputNumber @bind-Value="ConvenioEditar.DuracionMeses" class="form-control" readonly="@esEdicion" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Estado:</label>
                    <InputSelect @bind-Value="ConvenioEditar.Estado" class="form-select" disabled="@esEdicion">
                        <option value="Activo">Activo</option>
                        <option value="Vencido">Vencido</option>
                        <option value="En Renovación">En Renovación</option>
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Actualizar Archivo (PDF):</label>
                    <InputFile OnChange="OnFileSelected" class="form-control" disabled="@esEdicion" accept=".pdf" />
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción y Objetivos:</label>
                    <InputTextArea @bind-Value="ConvenioEditar.DescripcionObjetivos" class="form-control" style="height: 120px;" readonly="@esEdicion" />
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <button type="button" class="btn btn-secondary me-auto" @onclick="Volver">Volver a la Lista</button>
            <button type="button" class="btn btn-info text-white me-2" @onclick="IrAEnviarCorreo">
                <i class="bi bi-envelope-fill"></i> Enviar PDF por Correo
            </button>

            @if (esEdicion)
            {
                <button type="button" class="btn btn-warning" @onclick="HabilitarEdicionConContrasena">
                    <i class="bi bi-lock-fill"></i> Habilitar Edición
                </button>
            }
            else
            {
                <button type="button" class="btn btn-danger me-2" @onclick="Eliminar">Eliminar</button>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            }
        </div>
    </EditForm>
</div>

<div class="card shadow-lg">
    <div class="card-header">
        <h5>Visor del Convenio</h5>
    </div>
    <div class="card-body pdf-preview-container" style="height: 600px;">
        @if (ConvenioEditar.IdConvenio > 0 && ConvenioEditar.ContenidoArchivo != null)
        {
            <object data="/api/pdf/@ConvenioEditar.IdConvenio" type="application/pdf" class="w-100 h-100">
                <p>
                    Tu navegador no puede mostrar el PDF.
                    <a href="/api/pdf/@ConvenioEditar.IdConvenio" target="_blank">Descárgalo aquí</a>.
                </p>
            </object>
        }
        else
        {
            <div class="pdf-placeholder text-center p-5 bg-light">
                <p>No hay PDF guardado o es un convenio nuevo.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int ConvenioId { get; set; }

    public Convenio ConvenioEditar { get; set; } = new Convenio();

    private string? pdfPreviewUrl;
    private const long maxFileSize = 10 * 1024 * 1024;

    // Configuración de seguridad
    private const string ContrasenaMaestra = "admin123";
    private bool esEdicion = true;

    protected override async Task OnInitializedAsync()
    {
        var convenio = await conveniosService.Buscar(ConvenioId);
        if (convenio != null)
        {
            ConvenioEditar = convenio;

            // LÓGICA DE VISUALIZACIÓN DESDE BD
            if (ConvenioEditar.ContenidoArchivo != null && ConvenioEditar.ContenidoArchivo.Length > 0)
            {
                // Convertimos los bytes de la BD a una cadena Base64 que el navegador entiende
                var base64 = Convert.ToBase64String(ConvenioEditar.ContenidoArchivo);
                pdfPreviewUrl = $"data:application/pdf;base64,{base64}";
            }
        }
    }

    // Al seleccionar un nuevo archivo, lo leemos en memoria y actualizamos la vista previa
    public async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo == null || archivo.ContentType != "application/pdf")
        {
            return;
        }

        try
        {
            // 1. Leemos el archivo a un MemoryStream
            using var ms = new MemoryStream();
            await archivo.OpenReadStream(maxFileSize).CopyToAsync(ms);

            // 2. Actualizamos el Modelo para que esté listo para Guardar
            ConvenioEditar.ContenidoArchivo = ms.ToArray();
            ConvenioEditar.NombreArchivo = archivo.Name;

            // 3. Actualizamos la vista previa inmediatamente
            var base64 = Convert.ToBase64String(ConvenioEditar.ContenidoArchivo);
            pdfPreviewUrl = $"data:application/pdf;base64,{base64}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al leer el archivo: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error al cargar el archivo: " + ex.Message);
        }
    }

    public async Task GuardarCambios()
    {

        ConvenioEditar.UltimaModificacion = DateTime.Now;

        var guardado = await conveniosService.Guardar(ConvenioEditar);
        if (guardado)
        {
            navigationManager.NavigateTo("/listar-convenio");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudieron guardar los cambios.");
        }
    }

    private async Task HabilitarEdicionConContrasena()
    {
        var pass = await JSRuntime.InvokeAsync<string>("prompt", "Ingrese la contraseña de administrador:");
        if (pass == ContrasenaMaestra)
        {
            esEdicion = false;
        }
        else if (pass != null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Contraseña incorrecta.");
        }
    }

    public async Task Eliminar()
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Eliminar '{ConvenioEditar.Titulo}'?");
        if (confirmado)
        {
            // Soft Delete (Ocultar)
            ConvenioEditar.EsVisible = false;
            var guardado = await conveniosService.Guardar(ConvenioEditar);
            if (guardado) navigationManager.NavigateTo("/listar-convenio");
        }
    }

    private void Volver() => navigationManager.NavigateTo("/listar-convenio");

    private void IrAEnviarCorreo() => navigationManager.NavigateTo($"/Convenio/EnviarCorreo/{ConvenioId}");
}
@page "/reporte-convenio"
@inject NavigationManager NavManager
@inject ConveniosService ConveniosService
@inject IJSRuntime JS

@using QuestPDF.Fluent
@using QuestPDF.Helpers
@using QuestPDF.Infrastructure
@using ClosedXML.Excel
@using System.Globalization
@using RegistroConvenioUCNE.Models
@using RegistroConvenioUCNE.Services

@rendermode InteractiveServer

<div class="page-header">
    <h3>Reporte de Convenios</h3>
</div>

<div class="card shadow-lg">

    <div class="card-header">
        <h5>Filtros de Reporte</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <label for="fecha-desde" class="form-label">Desde</label>
                <input type="date" id="fecha-desde" class="form-control" @bind="fechaDesde" />
            </div>

            <div class="col-md-3">
                <label for="fecha-hasta" class="form-label">Hasta</label>
                <input type="date" id="fecha-hasta" class="form-control" @bind="fechaHasta" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Filtrar Por</label>
                <div class="input-group">
                    <select class="form-select" style="max-width: 150px;" @bind="Filtro">
                        <option value="Todos">Todos</option>
                        <option value="Titulo">Título</option>
                        <option value="Tipo">Tipo</option>
                        <option value="Estado">Estado</option>
                    </select>

                    <input type="text" class="form-control" placeholder="Escriba para buscar..."
                           @bind="filtroTexto" @bind:event="oninput" @onkeyup="Filtrar" />

                    <button class="btn btn-primary" @onclick="Filtrar">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Título</th>
                        <th>Fecha Firma</th>
                        <th>Instituciones</th>
                        <th>Categoría</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var convenio in conveniosMostrados)
                    {
                        <tr>
                            <td>@convenio.IdConvenio</td>
                            <td class="fw-bold">@convenio.Titulo</td>
                            <td>@convenio.FechaFirma.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (convenio.ConvenioInstituciones != null && convenio.ConvenioInstituciones.Any())
                                {
                                    @string.Join(", ", convenio.ConvenioInstituciones.Select(c => c.Institucion?.Nombre ?? "N/A"))
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>@convenio.Categoria</td>
                            <td>@convenio.TipoConvenio</td>
                            <td>
                                <span class="badge @GetEstadoClass(convenio.Estado)">
                                    @convenio.Estado
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!conveniosMostrados.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3">No se encontraron registros para generar reporte.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer">
        <div>
            <strong>Registros encontrados: @conveniosMostrados.Count()</strong>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success" @onclick="ExportarExcel">
                <i class="bi bi-file-earmark-excel"></i> Exportar Excel
            </button>
            <button class="btn btn-danger" @onclick="ExportarPDF">
                <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
            </button>
            <a href="/pantalla-principal" class="btn btn-secondary">Volver</a>
        </div>
    </div>
</div>

@code {
    private string filtroTexto = "";
    private string Filtro = "Todos";
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;

    private List<Convenio> listaCompletaConvenios = new();
    private List<Convenio> conveniosMostrados = new();

    protected override async Task OnInitializedAsync()
    {
        // Se carga la lista completa
        listaCompletaConvenios = await ConveniosService.Listar(c => c.EsVisible == true);
        Filtrar();
    }

    private void Filtrar()
    {
        var query = listaCompletaConvenios.AsQueryable();
        string texto = filtroTexto.ToLower().Trim();

        if (!string.IsNullOrWhiteSpace(texto))
        {
            if (Filtro == "Titulo")
                query = query.Where(c => c.Titulo != null && c.Titulo.ToLower().Contains(texto));
            else if (Filtro == "Tipo")
                query = query.Where(c => c.TipoConvenio != null && c.TipoConvenio.ToLower().Contains(texto));
            else if (Filtro == "Estado")
                query = query.Where(c => c.Estado != null && c.Estado.ToLower().Contains(texto));
            else
            {
                query = query.Where(c =>
                    (c.Titulo != null && c.Titulo.ToLower().Contains(texto)) ||
                    (c.TipoConvenio != null && c.TipoConvenio.ToLower().Contains(texto)) ||
                    (c.Categoria != null && c.Categoria.ToLower().Contains(texto)) ||
                    (c.Estado != null && c.Estado.ToLower().Contains(texto))
                );
            }
        }

        if (fechaDesde.HasValue)
            query = query.Where(c => c.FechaFirma.Date >= fechaDesde.Value.Date);

        if (fechaHasta.HasValue)
            query = query.Where(c => c.FechaFirma.Date <= fechaHasta.Value.Date);

        conveniosMostrados = query.ToList();
    }

    private string GetEstadoClass(string? estado)
    {
        if (string.IsNullOrEmpty(estado)) return "text-bg-secondary";
        return estado.ToLower() switch
        {
            "activo" => "text-bg-success",
            "vencido" => "text-bg-danger",
            "en renovación" => "text-bg-warning",
            _ => "text-bg-secondary"
        };
    }

    // --- LÓGICA EXPORTAR PDF ACTUALIZADA ---
    private async Task ExportarPDF()
    {
        QuestPDF.Settings.License = LicenseType.Community;
        var documento = Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(PageSizes.A4.Landscape());
                page.Margin(1, Unit.Centimetre); 
                page.PageColor(Colors.White);
                page.DefaultTextStyle(x => x.FontSize(9)); 

                page.Header().Text("Reporte de Convenios UCNE").SemiBold().FontSize(18).FontColor(Colors.Blue.Medium);

                page.Content().PaddingVertical(1, Unit.Centimetre).Table(table =>
                {
                    table.ColumnsDefinition(columns =>
                    {
                        columns.ConstantColumn(30);  // No
                        columns.RelativeColumn(2);   // Título (Más espacio)
                        columns.ConstantColumn(65);  // Fecha
                        columns.RelativeColumn(2);   // Instituciones
                        columns.ConstantColumn(70);  // Categoría
                        columns.ConstantColumn(80);  // Tipo
                        columns.ConstantColumn(60);  // Estado
                    });

                    table.Header(header =>
                    {
                        header.Cell().Element(CellStyle).Text("No.");
                        header.Cell().Element(CellStyle).Text("Título");
                        header.Cell().Element(CellStyle).Text("Fecha");
                        header.Cell().Element(CellStyle).Text("Instituciones");
                        header.Cell().Element(CellStyle).Text("Categoría");
                        header.Cell().Element(CellStyle).Text("Tipo");
                        header.Cell().Element(CellStyle).Text("Estado");
                        static IContainer CellStyle(IContainer container) => container.DefaultTextStyle(x => x.SemiBold()).BorderBottom(1).PaddingVertical(5);
                    });

                    foreach (var convenio in conveniosMostrados)
                    {
                        table.Cell().Element(CellStyle).Text(convenio.IdConvenio.ToString());
                        table.Cell().Element(CellStyle).Text(convenio.Titulo ?? "");
                        table.Cell().Element(CellStyle).Text(convenio.FechaFirma.ToString("dd/MM/yyyy"));

                        var inst = convenio.ConvenioInstituciones?.Any() == true
                            ? string.Join(", ", convenio.ConvenioInstituciones.Select(ci => ci.Institucion?.Nombre))
                            : "N/A";

                        table.Cell().Element(CellStyle).Text(inst);
                        table.Cell().Element(CellStyle).Text(convenio.Categoria ?? "");
                        table.Cell().Element(CellStyle).Text(convenio.TipoConvenio ?? "");
                        table.Cell().Element(CellStyle).Text(convenio.Estado ?? "");

                        static IContainer CellStyle(IContainer container) => container.BorderBottom(1).BorderColor(Colors.Grey.Lighten3).PaddingVertical(5);
                    }
                });
            });
        });

        var stream = new MemoryStream(documento.GeneratePdf());
        using var streamRef = new DotNetStreamReference(stream: stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", "ReporteConvenios.pdf", streamRef);
    }

    // --- LÓGICA EXPORTAR EXCEL ACTUALIZADA ---
    private async Task ExportarExcel()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Convenios");

        // Cabeceras
        worksheet.Cell(1, 1).Value = "No.";
        worksheet.Cell(1, 2).Value = "Título";
        worksheet.Cell(1, 3).Value = "Fecha Firma";
        worksheet.Cell(1, 4).Value = "Instituciones";
        worksheet.Cell(1, 5).Value = "Categoría";
        worksheet.Cell(1, 6).Value = "Tipo";
        worksheet.Cell(1, 7).Value = "Estado";

        var header = worksheet.Range("A1:G1");
        header.Style.Font.Bold = true;
        header.Style.Fill.BackgroundColor = XLColor.LightGray;

        int row = 2;
        foreach (var c in conveniosMostrados)
        {
            worksheet.Cell(row, 1).Value = c.IdConvenio;
            worksheet.Cell(row, 2).Value = c.Titulo;
            worksheet.Cell(row, 3).Value = c.FechaFirma;

            var inst = c.ConvenioInstituciones?.Any() == true
                ? string.Join(", ", c.ConvenioInstituciones.Select(i => i.Institucion?.Nombre))
                : "N/A";

            worksheet.Cell(row, 4).Value = inst;
            worksheet.Cell(row, 5).Value = c.Categoria;
            worksheet.Cell(row, 6).Value = c.TipoConvenio;
            worksheet.Cell(row, 7).Value = c.Estado;
            row++;
        }
        worksheet.Columns().AdjustToContents();

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Position = 0;
        using var streamRef = new DotNetStreamReference(stream: stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", "ReporteConvenios.xlsx", streamRef);
    }
}
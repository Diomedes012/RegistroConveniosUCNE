@page "/perfil"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RegistroConvenioUCNE.Data
@using RegistroConvenioUCNE.Models

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Context
@inject NavigationManager NavManager

<div class="page-header">
    <h3>Perfil de Usuario</h3>
</div>

<div class="card shadow-lg">
    <div class="card-body profile-card-body">

        @if (isLoading)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-4 text-center d-flex align-items-center justify-content-center flex-column">
                    <i class="bi bi-person-circle profile-icon-large" style="font-size: 8rem; color: #ccc;"></i>
                    <h5 class="mt-3 text-muted">@user.Rol</h5>
                </div>

                <div class="col-lg-8 p-4">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <div class="profile-field-box d-flex justify-content-between align-items-center border p-2 rounded">
                            <span>@(string.IsNullOrEmpty(user.Nombre) ? "Sin definir" : user.Nombre)</span>
                            <button class="btn btn-sm btn-link profile-edit-btn" @onclick='() => OpenEditModal("Nombre")'>
                                <i class="bi bi-pencil"></i> Editar
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Correo electrónico</label>
                        <div class="profile-field-box d-flex justify-content-between align-items-center border p-2 rounded bg-light">
                            <span>@user.Correo</span>
                            <button class="btn btn-sm btn-link profile-edit-btn" disabled title="Contacte al administrador para cambiar el correo">
                                <i class="bi bi-lock"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Cargo / Puesto</label>
                        <div class="profile-field-box d-flex justify-content-between align-items-center border p-2 rounded">
                            <span>@(string.IsNullOrEmpty(user.Rol) ? "Sin Cargo" : user.Rol)</span>
                            <button class="btn btn-sm btn-link profile-edit-btn" @onclick='() => OpenEditModal("Rol")'>
                                <i class="bi bi-pencil"></i> Editar
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Número de teléfono</label>
                        <div class="profile-field-box d-flex justify-content-between align-items-center border p-2 rounded">
                            <span>@(string.IsNullOrEmpty(user.Telefono) ? "Sin teléfono" : user.Telefono)</span>
                            <button class="btn btn-sm btn-link profile-edit-btn" @onclick='() => OpenEditModal("Telefono")'>
                                <i class="bi bi-pencil"></i> Editar
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Departamento</label>
                        <div class="profile-field-box d-flex justify-content-between align-items-center border p-2 rounded">
                            <span>@departamentoMostrado</span>
                            <button class="btn btn-sm btn-link profile-edit-btn" disabled>
                                <i class="bi bi-lock"></i> (Fijo)
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show" tabindex="-1" style="display: block;" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar @currentEditField</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    <p>Introduce el nuevo valor para <strong>@currentEditField</strong>:</p>
                    <input type="text" class="form-control" @bind="currentValueToEdit" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveChanges">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Modelo interno para la vista
    private class UserProfileModel
    {
        public string Nombre { get; set; } = "";
        public string Correo { get; set; } = "";
        public string Rol { get; set; } = ""; // Mapearemos esto al 'Cargo' de Responsable
        public string Telefono { get; set; } = "";
    }

    private UserProfileModel user = new UserProfileModel();
    private string departamentoMostrado = ""; 
    private bool isLoading = true;
    private bool showModal = false;
    private string currentEditField = "";
    private string currentValueToEdit = "";

    // Variables para guardar referencia a los objetos de BD
    private ApplicationUser? identityUser;
    private Responsable? responsableEntity;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosUsuario();
    }

    private async Task CargarDatosUsuario()
    {
        isLoading = true;
        try
        {
            // 1. Obtener estado de autenticación
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;

            if (userPrincipal.Identity?.IsAuthenticated ?? false)
            {
                // 2. Obtener usuario de Identity
                identityUser = await UserManager.GetUserAsync(userPrincipal);

                if (identityUser != null)
                {
                    user.Correo = identityUser.Email ?? "";

                    // 3. Buscar datos en la tabla Responsables usando el Email
                    responsableEntity = await Context.Responsable
                                            .FirstOrDefaultAsync(r => r.Email == identityUser.Email);

                    if (responsableEntity != null)
                    {
                        // Si existe en tabla Responsables, usamos esos datos
                        user.Nombre = responsableEntity.Nombre;
                        user.Telefono = responsableEntity.Telefono ?? "";
                        user.Rol = responsableEntity.Cargo ?? ""; // Cargo visual
                        departamentoMostrado = responsableEntity.Departamento ?? "";
                    }
                    else
                    {
                        // Si no existe (ej. Admin global sin perfil), usamos datos por defecto
                        user.Nombre = identityUser.UserName ?? "Usuario";
                        var roles = await UserManager.GetRolesAsync(identityUser);
                        user.Rol = roles.FirstOrDefault() ?? "Usuario";
                        departamentoMostrado = "General";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando perfil: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEditModal(string fieldName)
    {
        currentEditField = fieldName;
        switch (fieldName)
        {
            case "Nombre": currentValueToEdit = user.Nombre; break;
            case "Rol": currentValueToEdit = user.Rol; break; 
            case "Telefono": currentValueToEdit = user.Telefono; break;
        }
        showModal = true;
    }

    private async Task SaveChanges()
    {
        if (responsableEntity != null)
        {
            switch (currentEditField)
            {
                case "Nombre":
                    responsableEntity.Nombre = currentValueToEdit;
                    user.Nombre = currentValueToEdit;
                    break;
                case "Rol":
                    responsableEntity.Cargo = currentValueToEdit;
                    user.Rol = currentValueToEdit;
                    break;
                case "Telefono":
                    responsableEntity.Telefono = currentValueToEdit;
                    user.Telefono = currentValueToEdit;
                    break;
            }

            // Guardar en Base de Datos
            Context.Responsable.Update(responsableEntity);
            await Context.SaveChangesAsync();
        }
        else
        {
            // Opcional: Crear el registro si no existe
            // Por ahora solo actualizamos la vista localmente si no hay BD
            if (currentEditField == "Nombre") user.Nombre = currentValueToEdit;
        }

        showModal = false;
    }

    private void CancelEdit()
    {
        showModal = false;
    }
}
@inherits LayoutComponentBase

<div class="page-container">

    <header class="main-header">
        <NavLink class="nav-link-logo" href="/pantalla-principal">
            <img src="lib/images/logo1.png" alt="Logo UCNE" class="header-logo" />
            <span class="header-title">Gestion de Convenios</span>
        </NavLink>

        <nav class="header-nav">
            <NavLink href="pantalla-principal" class="nav-item" Match="NavLinkMatch.All">
                Inicio
            </NavLink>
            <NavLink href="crear-convenio" class="nav-item">
                Crear convenio
            </NavLink>
            <NavLink href="listar-convenio" class="nav-item">
                Listar convenio
            </NavLink>
            <NavLink href="reporte-convenio" class="nav-item">
                Reporte convenio
            </NavLink>
        </nav>
    </header>

    <div class="content-wrapper">

        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>